; Reconstructed R1 source-resource preview. Not a restored natural save.
config_version=5

[application]
config/name="Legend · R1 Source Preview"
config/use_custom_user_dir=true
config/custom_user_dir_name="Tihu-Legend-Godot"
run/main_scene="res://scenes/earth_new_game_candidate.tscn"
config/features=PackedStringArray("4.6", "GL Compatibility")

[display]
window/size/viewport_width=1024
window/size/viewport_height=768
window/size/window_width_override=1024
window/size/window_height_override=768
window/stretch/mode="canvas_items"

[physics]
common/physics_ticks_per_second=50

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false
textures/canvas_textures/default_texture_filter=0
