.inventory-window{padding-left:2.0px;padding-right:2.0px;padding-top:2.0px;padding-bottom:2.0px;overflow:hidden;}
.inventory-window .management-window-header{margin-bottom:2.0px;}
.inventory-header-title-wrap{height:44.0px;flex-direction:row;align-items:center;flex-grow:1.0;flex-shrink:1.0;min-width:0.0px;}
.inventory-header-icon{width:42.0px;height:42.0px;margin-right:6.0px;flex-grow:0.0;flex-shrink:0.0;-unity-background-scale-mode:stretch-to-fill;}
.inventory-title{flex-grow:1.0;flex-shrink:1.0;min-width:0.0px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;}
.inventory-header-meta{height:44.0px;flex-direction:row;align-items:center;justify-content:flex-end;flex-grow:0.0;flex-shrink:0.0;margin-left:4.0px;margin-right:4.0px;}
.inventory-meta-icon{width:30.0px;height:30.0px;margin-left:5.0px;margin-right:2.0px;flex-grow:0.0;flex-shrink:0.0;-unity-background-scale-mode:stretch-to-fill;}
.inventory-gold-text{width:94.0px;height:38.0px;font-size:29.0px;-unity-font-style:bold;-unity-text-align:middle-left;}
.inventory-count-text{width:78.0px;height:38.0px;font-size:29.0px;-unity-font-style:bold;-unity-text-align:middle-left;}
.inventory-body{min-height:0.0px;}
.inventory-content{flex-grow:1.0;flex-shrink:1.0;min-height:0.0px;flex-direction:row;}
.inventory-left-column{width:306.0px;min-width:306.0px;max-width:306.0px;margin-right:2.0px;flex-grow:0.0;flex-shrink:0.0;}
.inventory-right-column{flex-grow:1.0;flex-shrink:1.0;min-width:0.0px;min-height:0.0px;}
.inventory-gear-section{height:120.0px;min-height:120.0px;margin-bottom:2.0px;padding-left:5.0px;padding-right:5.0px;padding-top:3.0px;padding-bottom:5.0px;flex-grow:0.0;flex-shrink:0.0;}
.inventory-loot-section{flex-grow:1.0;flex-shrink:1.0;min-height:0.0px;margin-bottom:0.0px;padding-left:5.0px;padding-right:5.0px;padding-top:3.0px;padding-bottom:5.0px;}
.inventory-section-title{height:24.0px;min-height:24.0px;flex-grow:0.0;flex-shrink:0.0;font-size:22.0px;-unity-font-style:bold;-unity-text-align:middle-left;}
.inventory-gear-grid{flex-grow:1.0;flex-shrink:1.0;min-height:0.0px;flex-direction:row;align-items:flex-start;}
.inventory-gear-slot-outer{width:58.0px;height:88.0px;margin-right:1.0px;position:relative;overflow:visible;flex-grow:0.0;flex-shrink:0.0;}
.inventory-gear-slot{position:absolute;left:7.0px;right:7.0px;top:0.0px;height:66.0px;margin-bottom:0.0px;padding-left:2.0px;padding-right:2.0px;padding-top:2.0px;padding-bottom:2.0px;overflow:visible;}
.inventory-gear-selection-glow{left:4.0px;right:4.0px;top:-4.0px;bottom:18.0px;}
.inventory-gear-selection-highlight{left:5.0px;right:5.0px;top:-3.0px;bottom:19.0px;}
.inventory-row-selection-glow{left:3.0px;right:3.0px;top:1.0px;bottom:-1.0px;}
.inventory-row-selection-highlight{left:4.0px;right:4.0px;top:2.0px;bottom:0.0px;}
.inventory-item-icon{-unity-background-scale-mode:scale-to-fit;}
.inventory-gear-slot-icon{position:absolute;left:6.0px;right:6.0px;top:9.0px;bottom:9.0px;}
.inventory-gear-slot-label{position:absolute;left:3.0px;right:3.0px;top:68.0px;height:17.0px;font-size:12.0px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;-unity-text-align:middle-center;}
.inventory-rarity-strip{width:12.0px;flex-grow:0.0;flex-shrink:0.0;background-image:url("RareStrip_sharedassets0.assets_100.png");-unity-background-scale-mode:stretch-to-fill;}
.inventory-gear-rarity-strip{position:absolute;left:8.0px;top:7.0px;bottom:7.0px;}
.inventory-loot-scroll{flex-grow:1.0;flex-shrink:1.0;min-height:0.0px;}
.inventory-loot-rows{flex-grow:1.0;flex-shrink:1.0;min-height:0.0px;}
.inventory-row-outer{height:72.0px;margin-bottom:1.0px;flex-grow:0.0;flex-shrink:0.0;position:relative;overflow:visible;}
.inventory-row-button{position:absolute;left:0.0px;right:0.0px;top:0.0px;bottom:0.0px;margin-bottom:0.0px;padding-left:5.0px;padding-right:5.0px;padding-top:4.0px;padding-bottom:4.0px;flex-direction:row;align-items:center;}
.inventory-row-icon-frame{width:44.0px;height:66.0px;margin-right:3.0px;position:relative;overflow:hidden;flex-grow:0.0;flex-shrink:0.0;}
.inventory-row-rarity-strip{position:absolute;left:8.0px;top:8.0px;bottom:8.0px;}
.inventory-row-icon{position:absolute;left:6.0px;right:6.0px;top:9.0px;bottom:9.0px;}
.inventory-row-name{height:58.0px;min-width:0.0px;flex-grow:1.0;flex-shrink:1.0;font-size:20.0px;white-space:normal;overflow:hidden;-unity-font-style:bold;-unity-text-align:middle-left;}
.inventory-row-meta{width:52.0px;height:58.0px;margin-left:3.0px;flex-grow:0.0;flex-shrink:0.0;}
.inventory-row-slot{height:27.0px;flex-grow:0.0;flex-shrink:0.0;font-size:17.0px;white-space:nowrap;text-overflow:ellipsis;-unity-font-style:bold;-unity-text-align:middle-right;}
.inventory-row-power{height:29.0px;flex-grow:0.0;flex-shrink:0.0;bottom:6.0px;font-size:20.0px;-unity-font-style:bold;-unity-text-align:middle-right;}
.inventory-row-state{display:none;}
.inventory-details-section{flex-grow:1.0;flex-shrink:1.0;min-height:0.0px;margin-bottom:0.0px;padding-left:5.0px;padding-right:5.0px;padding-top:3.0px;padding-bottom:5.0px;}
.inventory-details-body{flex-grow:1.0;flex-shrink:1.0;min-height:0.0px;flex-direction:column;}
.inventory-details-top{height:116.0px;min-height:116.0px;flex-direction:row;flex-grow:0.0;flex-shrink:0.0;}
.inventory-details-icon-frame{width:72.0px;height:108.0px;min-width:72.0px;min-height:108.0px;margin-top:2.0px;margin-right:6.0px;position:relative;padding-left:0.0px;padding-right:0.0px;padding-top:0.0px;padding-bottom:0.0px;flex-grow:0.0;flex-shrink:0.0;}
.inventory-details-icon{position:absolute;left:8.0px;right:8.0px;top:12.0px;bottom:12.0px;}
.inventory-details-copy{flex-grow:1.0;flex-shrink:1.0;min-width:0.0px;min-height:0.0px;}
.inventory-details-title{height:60.0px;font-size:24.0px;-unity-font-style:bold;white-space:normal;overflow:hidden;-unity-text-align:upper-left;}
.inventory-details-slot{height:24.0px;flex-grow:0.0;flex-shrink:0.0;min-width:0.0px;font-size:18.0px;-unity-font-style:bold;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;-unity-text-align:middle-left;}
.inventory-details-power-line{height:24.0px;flex-direction:row;align-items:center;flex-grow:0.0;flex-shrink:0.0;}
.inventory-details-power{height:24.0px;flex-grow:1.0;flex-shrink:1.0;min-width:0.0px;font-size:18.0px;-unity-font-style:bold;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;-unity-text-align:middle-left;}
.inventory-details-power-delta{height:24.0px;margin-left:3.0px;flex-grow:0.0;flex-shrink:0.0;font-size:18.0px;-unity-font-style:bold;-unity-text-align:middle-right;}
.inventory-details-stats{margin-top:3.0px;padding-left:2.0px;padding-right:2.0px;flex-grow:1.0;flex-shrink:1.0;min-height:0.0px;}
.inventory-stat-row{height:24.0px;margin-bottom:1.0px;flex-direction:row;align-items:center;flex-grow:0.0;flex-shrink:0.0;}
.inventory-stat-value, .inventory-stat-empty{height:24.0px;width:auto;flex-grow:0.0;flex-shrink:1.0;min-width:0.0px;font-size:19.0px;-unity-font-style:bold;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;-unity-text-align:middle-left;}
.inventory-stat-delta{width:auto;height:24.0px;margin-left:4.0px;flex-grow:0.0;flex-shrink:0.0;font-size:19.0px;-unity-font-style:bold;-unity-text-align:middle-left;}
.inventory-stat-lost-heading{height:23.0px;margin-top:2.0px;margin-bottom:1.0px;flex-grow:0.0;flex-shrink:0.0;font-size:18.0px;-unity-font-style:bold;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;-unity-text-align:middle-left;}
.inventory-notification{height:28.0px;min-height:28.0px;margin-top:2.0px;margin-bottom:2.0px;font-size:21.0px;-unity-font-style:bold;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;-unity-text-align:middle-center;}
.inventory-actions{height:56.0px;flex-direction:row;flex-grow:0.0;flex-shrink:0.0;}
.inventory-action-button{width:0.0px;height:56.0px;min-width:0.0px;margin-left:1.0px;margin-right:1.0px;padding-left:4.0px;padding-right:4.0px;flex-grow:1.0;flex-shrink:1.0;font-size:30.0px;-unity-font-style:bold;}