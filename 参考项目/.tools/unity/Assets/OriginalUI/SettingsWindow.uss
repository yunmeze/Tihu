.settings-body{min-height:0.0px;}
.settings-scroll{flex-grow:1.0;flex-shrink:1.0;min-height:0.0px;}
.settings-scroll-content{padding-right:8.0px;flex-direction:column;}
.settings-toggle{margin-bottom:0.0px;}
.settings-row{min-height:66.0px;flex-direction:row;align-items:center;}
.settings-label{width:120.0px;font-size:29.0px;-unity-text-align:middle-left;}
.settings-selector{flex-grow:1.0;min-height:58.0px;margin-bottom:0.0px;justify-content:center;}
.settings-dropdown-instance{flex-shrink:1.0;}
.settings-language-dropdown-instance .management-window-dropdown-label{width:76.0px;min-width:0.0px;flex-grow:0.0;flex-shrink:0.0;}
.settings-language-dropdown-instance .management-window-dropdown-icon{display:flex;position:absolute;left:76.0px;top:0.0px;width:44.0px;height:48.0px;background-image:url("SettingsLanguageIcon_sharedassets0.assets_89.png");-unity-background-image-tint-color:rgba(255,255,255,1.0);}
.settings-dropdown-instance .management-window-dropdown{min-height:48.0px;flex-grow:1.0;margin-bottom:0.0px;font-size:27.0px;color:rgba(220,210,192,1.0);}
.settings-volume-instance{flex-grow:1.0;}
.settings-actions{min-height:64.0px;flex-direction:row;flex-grow:0.0;flex-shrink:0.0;margin-top:8.0px;padding-bottom:2.0px;}
.settings-action{flex-grow:1.0;height:58.0px;font-size:38.0px;white-space:normal;-unity-text-align:middle-center;}
.settings-summary{min-height:74.0px;margin-top:0.0px;padding-left:10.0px;padding-right:10.0px;padding-top:8.0px;padding-bottom:8.0px;white-space:normal;}
.settings-socials{min-height:78.0px;flex-direction:row;justify-content:center;align-items:center;margin-top:2.0px;margin-bottom:2.0px;}
.settings-discord-button{width:64.0px;height:64.0px;min-width:64.0px;min-height:64.0px;max-width:64.0px;max-height:64.0px;padding-left:8.0px;padding-right:8.0px;padding-top:8.0px;padding-bottom:8.0px;}
.settings-discord-icon{width:100.0%;height:100.0%;background-image:url("Discord-Symbol-Blurple_sharedassets0.assets_26.png");-unity-background-scale-mode:scale-to-fit;-unity-background-image-tint-color:rgba(255,255,255,1.0);}