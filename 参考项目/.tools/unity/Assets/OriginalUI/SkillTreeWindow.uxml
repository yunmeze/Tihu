<ui:UXML xmlns:ui="UnityEngine.UIElements"><Style src="ManagementWindow.uss"/><Style src="SkillTreeWindow.uss"/><ui:Template name="SkillNodeCard" src="SkillNodeCard.uxml"/><ui:Template name="SkillTreeLink" src="SkillTreeLink.uxml"/><ui:VisualElement name="skill-tree-window" class="management-window skill-tree-window"><ui:VisualElement name="SkillTreeHeader" class="management-window-header"><ui:Label name="TitleLabel" text="Gold Tree" class="management-window-title"></ui:Label><ui:Button name="CloseButton" text="X" class="management-window-close"></ui:Button></ui:VisualElement><ui:VisualElement name="BodyRoot" class="management-window-body skill-tree-body"><ui:VisualElement name="SkillTreeTopRow" class="skill-tree-top-row"><ui:Label name="PointsLabel" text="Gold: 0" class="management-window-accent-text skill-tree-points"></ui:Label><ui:VisualElement name="SkillTreeToolbarActions" class="skill-tree-toolbar-actions"><ui:Label name="ZoomLabel" text="100%" class="management-window-muted-text skill-tree-zoom-label"></ui:Label><ui:Button name="ResetViewButton" text="Center" class="management-window-action-button skill-tree-center-button"></ui:Button><ui:Button name="SkillTreeSummaryButton" text="Stats" class="management-window-action-button skill-tree-summary-button"></ui:Button></ui:VisualElement></ui:VisualElement><ui:VisualElement name="SkillTreeViewport" class="management-window-summary skill-tree-viewport"><ui:VisualElement name="SkillTreeGraphArea" class="skill-tree-graph-area"><ui:VisualElement name="SkillTreeContent" class="skill-tree-content"><ui:VisualElement name="SkillTreeCore" picking-mode="Ignore" class="management-window-button-frame skill-tree-core"><ui:Label name="SkillTreeCoreLabel" text="Core" picking-mode="Ignore" class="management-window-accent-text skill-tree-core-label"></ui:Label></ui:VisualElement><ui:VisualElement name="SkillTreeLinksLayer" picking-mode="Ignore" class="skill-tree-links-layer"><ui:Instance name="SkillTreeLinkPreview" template="SkillTreeLink" class="skill-tree-builder-preview-link"></ui:Instance></ui:VisualElement><ui:VisualElement name="SkillTreeNodesLayer" class="skill-tree-nodes-layer"><ui:Instance name="SkillNodePreviewBlade" template="SkillNodeCard" class="skill-tree-builder-preview-node skill-tree-builder-preview-node--blade"><ui:AttributeOverrides element-name="SkillNodeGlyph" text="ATK"/><ui:AttributeOverrides element-name="SkillNodeName" text="Attack"/><ui:AttributeOverrides element-name="SkillNodeDescription" text="+10% Damage"/><ui:AttributeOverrides element-name="SkillNodeStatus" text="75g"/></ui:Instance><ui:Instance name="SkillNodePreviewGate" template="SkillNodeCard" class="skill-tree-builder-preview-node skill-tree-builder-preview-node--gate"><ui:AttributeOverrides element-name="SkillNodeGlyph" text="GATE"/><ui:AttributeOverrides element-name="SkillNodeName" text="Gate"/><ui:AttributeOverrides element-name="SkillNodeDescription" text="Unlocks feature"/><ui:AttributeOverrides element-name="SkillNodeStatus" text="4.2K"/></ui:Instance></ui:VisualElement></ui:VisualElement></ui:VisualElement><ui:VisualElement name="SkillTreeTooltip" picking-mode="Ignore" class="management-window-summary skill-tree-tooltip" style="-unity-background-image-tint-color:rgba(255,255,255,1.0);"><ui:Label name="SkillTreeTooltipTitle" text="Node" picking-mode="Ignore" class="management-window-text skill-tree-tooltip-title"></ui:Label><ui:Label name="SkillTreeTooltipDescription" text="Description" picking-mode="Ignore" class="management-window-muted-text skill-tree-tooltip-description"></ui:Label><ui:Label name="SkillTreeTooltipPrice" text="Price" picking-mode="Ignore" class="management-window-accent-text skill-tree-tooltip-price"></ui:Label></ui:VisualElement><ui:VisualElement name="SkillTreeSummaryTooltip" class="management-window-summary skill-tree-summary-tooltip"><ui:VisualElement name="SkillTreeSummaryHeader" class="skill-tree-summary-header"><ui:Label name="SkillTreeSummaryTitle" text="Purchased Stats" class="management-window-text skill-tree-summary-title"></ui:Label><ui:Button name="SkillTreeSummaryCloseButton" text="X" class="management-window-close skill-tree-summary-close-button"></ui:Button></ui:VisualElement><ui:ScrollView name="SkillTreeSummaryScroll" horizontal-scroller-visibility="Hidden" vertical-scroller-visibility="Auto" class="management-window-scroll skill-tree-summary-scroll"><ui:Label name="SkillTreeSummaryText" text="No purchased stats" class="management-window-text skill-tree-summary-text"></ui:Label></ui:ScrollView></ui:VisualElement></ui:VisualElement></ui:VisualElement></ui:VisualElement></ui:UXML>