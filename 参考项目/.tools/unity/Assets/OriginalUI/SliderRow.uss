.slider-row-slot{flex-direction:row;align-items:center;min-height:58.0px;padding-left:8.0px;padding-right:8.0px;margin-bottom:0.0px;}
.slider-row-track{position:relative;flex-grow:1.0;align-items:center;height:42.0px;background-color:rgba(0,0,0,0.0);background-image:url("Background0_sharedassets0.assets_73.png");-unity-background-scale-mode:stretch-to-fill;-unity-background-image-tint-color:rgba(190,145,105,0.30000001192092896);-unity-slice-left:22;-unity-slice-right:22;-unity-slice-top:22;-unity-slice-bottom:22;-unity-slice-scale:0.5px;}
.slider-row-rail{position:absolute;left:16.0px;right:16.0px;top:0.0px;bottom:0.0px;}
.slider-row-fill{position:absolute;left:-16.0px;right:50.0%;top:0.0px;bottom:0.0px;background-color:rgba(0,0,0,0.0);background-image:url("Background0_sharedassets0.assets_73.png");-unity-background-scale-mode:stretch-to-fill;-unity-background-image-tint-color:rgba(220,170,120,0.550000011920929);-unity-slice-left:22;-unity-slice-right:22;-unity-slice-top:22;-unity-slice-bottom:22;-unity-slice-scale:0.5px;}
.slider-row-dragger{position:absolute;left:50.0%;top:0.0px;width:32.0px;height:42.0px;translate:-50.0% 0.0;background-color:rgba(0,0,0,0.0);background-image:url("Button_sharedassets0.assets_98.png");-unity-background-scale-mode:stretch-to-fill;-unity-background-image-tint-color:rgba(255,255,255,1.0);-unity-slice-left:25;-unity-slice-right:25;-unity-slice-top:25;-unity-slice-bottom:25;-unity-slice-scale:0.5px;}
.slider-row-dragger:hover{-unity-background-image-tint-color:rgba(255,235,220,1.0);}
.slider-row-value{width:70.0px;font-size:24.0px;-unity-text-align:middle-right;color:rgba(246,202,96,1.0);}