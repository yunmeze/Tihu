<ui:UXML xmlns:ui="UnityEngine.UIElements"><Style src="DifficultyWindow.uss"/><Style src="ManagementWindow.uss"/><ui:Template name="DifficultyCard" src="DifficultyCard.uxml"/><ui:VisualElement name="difficulty-window" class="management-window difficulty-window"><ui:VisualElement name="DifficultyBackdrop" picking-mode="Ignore" class="difficulty-backdrop"></ui:VisualElement><ui:VisualElement name="DifficultyBackdropVignette" picking-mode="Ignore" class="difficulty-backdrop-vignette"></ui:VisualElement><ui:VisualElement name="DifficultyBackdropFade" picking-mode="Ignore" class="difficulty-backdrop-fade"></ui:VisualElement><ui:VisualElement name="DifficultyHeader" class="management-window-header"><ui:Label name="TitleLabel" text="Select Difficulty" class="management-window-title"></ui:Label><ui:Button name="CloseButton" text="X" class="management-window-close"></ui:Button></ui:VisualElement><ui:VisualElement name="BodyRoot" class="management-window-body difficulty-body"><ui:VisualElement name="DifficultyCopy" class="difficulty-copy"><ui:Label name="DifficultyStatus" text="ACTIVE" class="difficulty-status"></ui:Label><ui:Label name="DifficultyName" text="Normal" class="difficulty-name"></ui:Label><ui:Label name="DifficultyTagline" class="difficulty-tagline"></ui:Label><ui:VisualElement name="DifficultyDivider" class="difficulty-divider"></ui:VisualElement><ui:Label name="DifficultySectionTitle" text="LEVEL DETAILS" class="difficulty-section-title"></ui:Label><ui:Label name="DifficultyDetailsEnemies" class="difficulty-detail"></ui:Label><ui:Label name="DifficultyDetailsRewards" class="difficulty-detail"></ui:Label><ui:Label name="DifficultyDetailsProgression" class="difficulty-detail"></ui:Label><ui:Label name="DifficultyDetailsPenalty" class="difficulty-detail difficulty-penalty"></ui:Label></ui:VisualElement><ui:VisualElement name="DifficultyCardCarousel" class="difficulty-card-carousel"><ui:Button name="DifficultyPreviousButton" text="◀" tooltip="Previous difficulties" class="management-window-action-button difficulty-carousel-button difficulty-carousel-button-previous"></ui:Button><ui:ScrollView name="DifficultyCardScroll" mode="Horizontal" horizontal-scroller-visibility="Hidden" vertical-scroller-visibility="Hidden" class="difficulty-card-scroll"><ui:VisualElement name="DifficultyCardRow" class="difficulty-card-row"><ui:Instance name="DifficultyCard0" template="DifficultyCard"></ui:Instance><ui:Instance name="DifficultyCard1" template="DifficultyCard"></ui:Instance><ui:Instance name="DifficultyCard2" template="DifficultyCard"></ui:Instance><ui:Instance name="DifficultyCard3" template="DifficultyCard"></ui:Instance><ui:Instance name="DifficultyCard4" template="DifficultyCard"></ui:Instance><ui:Instance name="DifficultyCard5" template="DifficultyCard"></ui:Instance><ui:Instance name="DifficultyCard6" template="DifficultyCard"></ui:Instance><ui:Instance name="DifficultyCard7" template="DifficultyCard"></ui:Instance><ui:Instance name="DifficultyCard8" template="DifficultyCard"></ui:Instance><ui:Instance name="DifficultyCard9" template="DifficultyCard"></ui:Instance><ui:Instance name="DifficultyCard10" template="DifficultyCard"></ui:Instance><ui:Instance name="DifficultyCard11" template="DifficultyCard"></ui:Instance><ui:Instance name="DifficultyCard12" template="DifficultyCard"></ui:Instance></ui:VisualElement></ui:ScrollView><ui:Button name="DifficultyNextButton" text="▶" tooltip="Next difficulties" class="management-window-action-button difficulty-carousel-button difficulty-carousel-button-next"></ui:Button></ui:VisualElement><ui:VisualElement name="DifficultyActions" class="difficulty-actions"><ui:Button name="ConfirmButton" text="Confirm" class="management-window-action-button difficulty-confirm"></ui:Button></ui:VisualElement></ui:VisualElement><ui:VisualElement name="DifficultyFrame" picking-mode="Ignore" class="difficulty-frame-overlay"></ui:VisualElement></ui:VisualElement></ui:UXML>