.zone-hint{height:28.0px;margin-bottom:4.0px;flex-grow:0.0;flex-shrink:0.0;}
.zone-list{flex-grow:1.0;flex-shrink:1.0;min-height:0.0px;}
.zone-row-slot{height:86.0px;margin-bottom:6.0px;flex-shrink:0.0;position:relative;overflow:visible;}
.zone-row{position:absolute;left:6.0px;right:6.0px;top:6.0px;bottom:6.0px;margin-bottom:0.0px;padding-left:10.0px;padding-right:10.0px;padding-top:7.0px;padding-bottom:8.0px;flex-direction:column;justify-content:center;align-items:stretch;}
.zone-row-current:disabled{opacity:1.0;-unity-background-image-tint-color:rgba(255,255,255,1.0);color:rgba(220,210,192,1.0);}
.zone-row-selection-glow{left:10.0px;right:10.0px;top:6.0px;bottom:4.0px;}
.zone-row-selection-highlight{left:12.0px;right:12.0px;top:8.0px;bottom:6.0px;}
.zone-row-copy{flex-grow:0.0;flex-shrink:0.0;min-width:0.0px;width:100.0%;height:58.0px;justify-content:center;align-items:stretch;}
.zone-row-top{width:100.0%;height:34.0px;min-width:0.0px;flex-direction:row;align-items:center;}
.zone-row-name{height:34.0px;flex-grow:1.0;flex-shrink:1.0;min-width:0.0px;padding-left:8.0px;font-size:28.0px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;-unity-text-align:middle-left;}
.zone-row-status{width:190.0px;height:34.0px;flex-grow:0.0;flex-shrink:0.0;padding-right:8.0px;font-size:23.0px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;-unity-text-align:middle-right;}
.zone-row-loot{width:100.0%;height:24.0px;margin-top:0.0px;font-size:20.0px;-unity-text-align:middle-center;}