<ui:UXML xmlns:ui="UnityEngine.UIElements"><Style src="ManagementWindow.uss"/><Style src="SettingsWindow.uss"/><Style src="SliderRow.uss"/><ui:Template name="CheckboxRow" src="CheckboxRow.uxml"/><ui:Template name="ProjectDropdownRow" src="ProjectDropdownRow.uxml"/><ui:Template name="SliderRow" src="SliderRow.uxml"/><ui:VisualElement name="settings-window" class="management-window settings-window"><ui:VisualElement name="SettingsHeader" class="management-window-header"><ui:Label name="TitleLabel" text="Settings" class="management-window-title"></ui:Label><ui:Button name="CloseButton" text="X" class="management-window-close"></ui:Button></ui:VisualElement><ui:VisualElement name="BodyRoot" class="management-window-body settings-body"><ui:ScrollView name="SettingsScroll" horizontal-scroller-visibility="Hidden" vertical-scroller-visibility="Auto" class="settings-scroll management-window-scroll"><ui:VisualElement name="SettingsScrollContent" class="settings-scroll-content"><ui:Instance name="LanguageDropdown" template="ProjectDropdownRow" class="settings-dropdown-instance settings-language-dropdown-instance"><ui:AttributeOverrides element-name="ProjectDropdownRowLabel" text="Language"/></ui:Instance><ui:Instance template="CheckboxRow"><ui:AttributeOverrides element-name="CheckboxToggle" label="Always On Top"/></ui:Instance><ui:Instance template="CheckboxRow"><ui:AttributeOverrides element-name="CheckboxToggle" label="Snapping"/></ui:Instance><ui:Instance template="CheckboxRow"><ui:AttributeOverrides element-name="CheckboxToggle" label="Lock window"/></ui:Instance><ui:Instance name="SizeDropdown" template="ProjectDropdownRow" class="settings-dropdown-instance"><ui:AttributeOverrides element-name="ProjectDropdownRowLabel" text="Size"/></ui:Instance><ui:Instance name="PlacementDropdown" template="ProjectDropdownRow" class="settings-dropdown-instance"><ui:AttributeOverrides element-name="ProjectDropdownRowLabel" text="Farm"/></ui:Instance><ui:Instance name="ArenaDropdown" template="ProjectDropdownRow" class="settings-dropdown-instance"><ui:AttributeOverrides element-name="ProjectDropdownRowLabel" text="Arena"/></ui:Instance><ui:VisualElement name="MasterSettingRow" class="settings-row"><ui:Label name="MasterSettingLabel" text="Volume" class="management-window-text management-window-adaptive-label settings-label"></ui:Label><ui:Instance name="MasterVolumeControl" template="SliderRow" class="settings-volume-instance"><ui:AttributeOverrides element-name="SliderValueLabel" text="100%"/></ui:Instance></ui:VisualElement><ui:VisualElement name="SfxSettingRow" class="settings-row"><ui:Label name="SfxSettingLabel" text="SFX" class="management-window-text management-window-adaptive-label settings-label"></ui:Label><ui:Instance name="SfxVolumeControl" template="SliderRow" class="settings-volume-instance"><ui:AttributeOverrides element-name="SliderValueLabel" text="100%"/></ui:Instance></ui:VisualElement><ui:VisualElement name="MusicSettingRow" class="settings-row"><ui:Label name="MusicSettingLabel" text="Music" class="management-window-text management-window-adaptive-label settings-label"></ui:Label><ui:Instance name="MusicVolumeControl" template="SliderRow" class="settings-volume-instance"><ui:AttributeOverrides element-name="SliderValueLabel" text="50%"/></ui:Instance></ui:VisualElement><ui:VisualElement name="SettingsSocials" class="settings-socials" style="justify-content:flex-start;"><ui:Button name="DiscordButton" tooltip="Discord" class="management-window-action-button settings-discord-button" style="padding-top:10.0px;padding-right:10.0px;padding-bottom:10.0px;padding-left:10.0px;"><ui:VisualElement name="DiscordButtonIcon" picking-mode="Ignore" class="settings-discord-icon"></ui:VisualElement></ui:Button></ui:VisualElement><ui:Label name="SummaryLabel" text="Top: on | Size: 1x | Farm: bottom&#10;Snapping: on | Lock: off&#10;SFX: 100% | Music: 50%" class="management-window-summary settings-summary"></ui:Label></ui:VisualElement></ui:ScrollView><ui:VisualElement name="SettingsActions" class="settings-actions" style="background-image:url(&quot;Background0_sharedassets0.assets_73.png&quot;);margin-top:2.0px;padding-top:4.0px;padding-bottom:5.0px;padding-right:4.0px;padding-left:4.0px;"><ui:Button name="MinimizeButton" text="Minimize" class="management-window-action-button settings-action"></ui:Button><ui:Button name="ExitButton" text="Exit Game" class="management-window-action-button management-window-danger-button settings-action"></ui:Button></ui:VisualElement></ui:VisualElement></ui:VisualElement></ui:UXML>