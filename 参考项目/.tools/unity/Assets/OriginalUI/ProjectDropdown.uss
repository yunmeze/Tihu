.dropdown-custom-slot{padding-left:0.0px;padding-right:0.0px;padding-top:0.0px;padding-bottom:0.0px;}
.dropdown-custom-functional{flex-grow:1.0;min-height:48.0px;margin-bottom:0.0px;padding-left:0.0px;padding-right:0.0px;padding-top:0.0px;padding-bottom:0.0px;color:rgba(220,210,192,1.0);font-size:27.0px;}
.dropdown-custom-functional .unity-base-field__label{display:none;}
.dropdown-custom-functional .unity-base-popup-field__input, .dropdown-custom-functional .unity-popup-field__input{min-height:48.0px;background-color:rgba(0,0,0,0.0);background-image:url("Button_sharedassets0.assets_98.png");-unity-background-scale-mode:stretch-to-fill;-unity-background-image-tint-color:rgba(255,255,255,1.0);-unity-slice-left:25;-unity-slice-right:25;-unity-slice-top:25;-unity-slice-bottom:25;-unity-slice-scale:0.5px;border-left-width:0.0px;border-right-width:0.0px;border-top-width:0.0px;border-bottom-width:0.0px;}
.dropdown-custom-functional .unity-base-popup-field__input:hover, .dropdown-custom-functional .unity-popup-field__input:hover{-unity-background-image-tint-color:rgba(255,235,220,1.0);}
.dropdown-custom-functional .unity-base-popup-field__text{color:rgba(0,0,0,0.0);font-size:27.0px;opacity:0.0;}
.dropdown-custom-functional .unity-base-popup-field__arrow{width:24.0px;min-width:24.0px;height:24.0px;margin-left:8.0px;margin-right:2.0px;-unity-background-image-tint-color:rgba(0,0,0,0.0);opacity:0.0;}
.management-window-dropdown:disabled .dropdown-custom-functional .unity-base-popup-field__input, .management-window-dropdown:disabled .dropdown-custom-functional .unity-popup-field__input{-unity-background-image-tint-color:rgba(105,95,85,1.0);}
.management-window-dropdown:disabled .dropdown-custom-overlay .dropdown-custom-text{color:rgba(158,146,126,1.0);}
.management-window-dropdown:disabled .dropdown-custom-overlay .dropdown-custom-arrow{color:rgba(158,146,126,1.0);}
.dropdown-custom-overlay{position:absolute;left:0.0px;right:0.0px;top:0.0px;bottom:0.0px;flex-direction:row;align-items:center;padding-left:13.0px;padding-right:10.0px;}
.dropdown-custom-text{flex-grow:1.0;color:rgba(220,210,192,1.0);font-size:27.0px;translate:0.0 -2.0px;-unity-text-align:middle-left;}
.dropdown-custom-arrow{color:rgba(220,210,192,1.0);font-size:22.0px;margin-left:8.0px;margin-right:2.0px;translate:0.0 -2.0px;-unity-text-align:middle-center;}