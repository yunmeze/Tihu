.offline-progress-window .management-window-header{height:44.0px;margin-bottom:6.0px;flex-shrink:0.0;}
.offline-progress-window .management-window-title{font-size:36.0px;white-space:nowrap;}
.offline-progress-window .management-window-close{width:44.0px;height:44.0px;font-size:36.0px;}
.offline-progress-body{justify-content:flex-start;padding-left:28.0px;padding-right:28.0px;padding-top:4.0px;}
.offline-progress-intro{height:32.0px;margin-bottom:10.0px;color:rgba(211,198,174,1.0);font-size:22.0px;-unity-text-align:middle-center;}
.offline-progress-time-panel{height:72.0px;margin-left:12.0px;margin-right:12.0px;margin-bottom:12.0px;flex-direction:row;flex-shrink:0.0;}
.offline-progress-row{height:72.0px;flex-grow:1.0;flex-shrink:0.0;flex-direction:column;justify-content:center;align-items:center;margin-left:5.0px;margin-right:5.0px;padding-top:7.0px;padding-bottom:7.0px;-unity-background-image-tint-color:rgba(190,145,105,0.3799999952316284);}
.offline-progress-label{height:24.0px;color:rgba(201,185,157,1.0);font-size:18.0px;-unity-text-align:middle-center;}
.offline-progress-value{height:30.0px;color:rgba(241,224,187,1.0);font-size:26.0px;-unity-font-style:bold;-unity-text-align:middle-center;}
.offline-progress-rewards{height:104.0px;margin-left:8.0px;margin-right:8.0px;margin-bottom:10.0px;flex-shrink:0.0;flex-direction:row;}
.offline-progress-reward-card{flex-grow:1.0;margin-left:9.0px;margin-right:9.0px;padding-top:10.0px;padding-bottom:8.0px;justify-content:center;align-items:center;-unity-background-image-tint-color:rgba(208,151,78,0.46000000834465027);}
.offline-progress-reward-label{height:28.0px;color:rgba(210,171,103,1.0);font-size:20.0px;-unity-font-style:bold;-unity-text-align:middle-center;}
.offline-progress-reward-value{height:44.0px;color:rgba(248,211,139,1.0);font-size:34.0px;-unity-font-style:bold;-unity-text-align:middle-center;}
.offline-progress-levels{height:28.0px;flex-shrink:0.0;margin-bottom:4.0px;color:rgba(226,197,137,1.0);font-size:20.0px;-unity-font-style:bold;-unity-text-align:middle-center;}
.offline-progress-note{height:64.0px;flex-shrink:0.0;margin-left:26.0px;margin-right:26.0px;margin-bottom:6.0px;color:rgba(190,181,164,1.0);font-size:16.0px;white-space:normal;-unity-text-align:middle-center;}
.offline-progress-continue{width:240.0px;min-height:52.0px;height:52.0px;margin-top:0.0px;margin-bottom:0.0px;flex-shrink:0.0;font-size:30.0px;align-self:center;-unity-text-align:middle-center;}