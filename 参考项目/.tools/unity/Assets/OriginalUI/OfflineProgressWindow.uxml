<ui:UXML xmlns:ui="UnityEngine.UIElements"><Style src="ManagementWindow.uss"/><Style src="OfflineProgressWindow.uss"/><ui:VisualElement name="offline-progress-window" class="management-window offline-progress-window"><ui:VisualElement name="OfflineProgressHeader" class="management-window-header"><ui:Label name="TitleLabel" text="While You Were Away" class="management-window-title"></ui:Label><ui:Button name="CloseButton" text="X" class="management-window-close"></ui:Button></ui:VisualElement><ui:VisualElement name="BodyRoot" class="management-window-body offline-progress-body"><ui:Label name="IntroLabel" text="Your hero kept training in the dark." class="management-window-hint-text offline-progress-intro"></ui:Label><ui:VisualElement name="TimePanel" class="offline-progress-time-panel"><ui:VisualElement name="AbsenceRow" class="management-window-summary offline-progress-row"><ui:Label name="AbsenceLabel" text="Time away" class="offline-progress-label"></ui:Label><ui:Label name="AbsenceValue" text="0m" class="offline-progress-value"></ui:Label></ui:VisualElement><ui:VisualElement name="EffectiveRow" class="management-window-summary offline-progress-row"><ui:Label name="EffectiveLabel" text="Effective time" class="offline-progress-label"></ui:Label><ui:Label name="EffectiveValue" text="0m" class="offline-progress-value"></ui:Label></ui:VisualElement></ui:VisualElement><ui:VisualElement name="RewardsPanel" class="offline-progress-rewards"><ui:VisualElement name="ExperienceCard" class="management-window-summary offline-progress-reward-card"><ui:Label name="ExperienceLabel" text="XP" class="offline-progress-reward-label"></ui:Label><ui:Label name="ExperienceValue" text="+0" class="offline-progress-reward-value"></ui:Label></ui:VisualElement><ui:VisualElement name="GoldCard" class="management-window-summary offline-progress-reward-card"><ui:Label name="GoldLabel" text="GOLD" class="offline-progress-reward-label"></ui:Label><ui:Label name="GoldValue" text="+0" class="offline-progress-reward-value"></ui:Label></ui:VisualElement></ui:VisualElement><ui:Label name="LevelsValue" text="+1 level" class="offline-progress-levels"></ui:Label><ui:Label name="OfflineLimitNote" text="Offline progress grants XP and combat Gold only. Items, bosses, and zone progress are not simulated." class="offline-progress-note"></ui:Label><ui:Button name="ContinueButton" text="Continue" class="management-window-control management-window-interactive-control management-window-success-button offline-progress-continue"></ui:Button></ui:VisualElement></ui:VisualElement></ui:UXML>