<ui:UXML xmlns:ui="UnityEngine.UIElements"><Style src="InventoryWindow.uss"/><Style src="ManagementWindow.uss"/><ui:VisualElement name="inventory-window" class="management-window inventory-window"><ui:VisualElement name="InventoryHeader" class="management-window-header"><ui:VisualElement name="InventoryHeaderTitleWrap" class="inventory-header-title-wrap"><ui:VisualElement name="HeaderBagIcon" class="inventory-header-icon"></ui:VisualElement><ui:Label name="TitleLabel" text="Inventory" class="management-window-title inventory-title"></ui:Label></ui:VisualElement><ui:VisualElement name="InventoryHeaderMeta" class="inventory-header-meta"><ui:VisualElement name="GoldIcon" class="inventory-meta-icon inventory-gold-icon"></ui:VisualElement><ui:Label name="GoldText" text="0" class="management-window-accent-text inventory-gold-text"></ui:Label><ui:VisualElement name="CountIcon" class="inventory-meta-icon inventory-count-icon"></ui:VisualElement><ui:Label name="CountText" text="0/20" class="management-window-accent-text inventory-count-text"></ui:Label></ui:VisualElement><ui:Button name="CloseButton" text="X" class="management-window-close"></ui:Button></ui:VisualElement><ui:VisualElement name="BodyRoot" class="management-window-body inventory-body"><ui:VisualElement name="InventoryContent" class="inventory-content"><ui:VisualElement name="InventoryLeftColumn" class="inventory-left-column"><ui:VisualElement name="GearSection" class="management-window-control inventory-gear-section"><ui:Label name="GearSectionTitle" text="Gear" class="management-window-accent-text inventory-section-title"></ui:Label><ui:VisualElement name="GearContainer" class="inventory-gear-grid"></ui:VisualElement></ui:VisualElement><ui:VisualElement name="LootSection" class="management-window-control inventory-loot-section"><ui:Label name="LootSectionTitle" text="Loot" class="management-window-accent-text inventory-section-title"></ui:Label><ui:ScrollView name="LootRows" horizontal-scroller-visibility="Hidden" vertical-scroller-visibility="Auto" class="inventory-loot-scroll management-window-scroll"></ui:ScrollView></ui:VisualElement></ui:VisualElement><ui:VisualElement name="InventoryRightColumn" class="inventory-right-column"><ui:VisualElement name="DetailsSection" class="management-window-control inventory-details-section"><ui:Label name="DetailsSectionTitle" text="Item" class="management-window-accent-text inventory-section-title"></ui:Label><ui:VisualElement name="DetailsBody" class="inventory-details-body"><ui:VisualElement name="DetailsTop" class="inventory-details-top"><ui:VisualElement name="DetailsIconFrame" class="management-window-control inventory-details-icon-frame"><ui:VisualElement name="DetailsIcon" class="inventory-item-icon inventory-details-icon"></ui:VisualElement></ui:VisualElement><ui:VisualElement name="DetailsCopy" class="inventory-details-copy"><ui:Label name="DetailsTitle" text="No loot" class="management-window-text management-window-rarity-common inventory-details-title"></ui:Label><ui:Label name="DetailsSlotText" text="" class="management-window-muted-text inventory-details-slot"></ui:Label><ui:VisualElement name="DetailsPowerLine" class="inventory-details-power-line"><ui:Label name="DetailsPowerText" text="" class="management-window-muted-text inventory-details-power"></ui:Label><ui:Label name="DetailsPowerDelta" text="" class="management-window-text inventory-details-power-delta"></ui:Label></ui:VisualElement></ui:VisualElement></ui:VisualElement><ui:VisualElement name="DetailsStats" class="inventory-details-stats"></ui:VisualElement></ui:VisualElement></ui:VisualElement><ui:Label name="NotificationLabel" text="" class="management-window-muted-text inventory-notification"></ui:Label><ui:VisualElement name="InventoryActions" class="inventory-actions"><ui:Button name="EquipButton" text="Equip" class="management-window-primary-button management-window-success-button inventory-action-button inventory-equip-button"></ui:Button><ui:Button name="SellButton" text="Sell" class="management-window-action-button management-window-danger-button inventory-action-button inventory-sell-button"></ui:Button></ui:VisualElement></ui:VisualElement></ui:VisualElement></ui:VisualElement></ui:VisualElement></ui:UXML>