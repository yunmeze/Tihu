.loot-filter-body{min-height:0.0px;}
.loot-filter-scroll{flex-grow:1.0;flex-shrink:1.0;min-height:0.0px;}
.loot-filter-scroll-content{flex-direction:column;padding-right:8.0px;}
.loot-filter-row-slot{position:relative;min-height:51.0px;margin-bottom:3.0px;flex-shrink:0.0;}
.loot-filter-row-slot .loot-filter-toggle{margin-bottom:0.0px;}
.loot-filter-selection-glow{left:3.0px;right:3.0px;top:0.0px;bottom:-1.0px;}
.loot-filter-selection-highlight{left:5.0px;right:5.0px;top:2.0px;bottom:1.0px;}
.loot-filter-stat-row{margin-bottom:9.0px;flex-shrink:0.0;}
.loot-filter-stat-row .management-window-dropdown{min-height:48.0px;margin-bottom:0.0px;font-size:27.0px;}
.loot-filter-stat-row .unity-base-popup-field__input, .loot-filter-stat-row .unity-popup-field__input{min-height:48.0px;}
.loot-filter-summary{min-height:64.0px;flex-grow:0.0;flex-shrink:0.0;margin-top:6.0px;padding-left:12.0px;padding-right:12.0px;padding-top:7.0px;font-size:22.0px;}
.loot-filter-unlock-label{min-height:24.0px;margin-top:-6.0px;margin-bottom:3.0px;padding-left:12.0px;font-size:18.0px;flex-shrink:0.0;}