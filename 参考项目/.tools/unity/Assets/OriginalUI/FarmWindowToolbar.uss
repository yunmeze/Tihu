.farm-toolbar-panel{position:absolute;right:6.0px;bottom:6.0px;flex-direction:column;align-items:flex-end;padding-left:0.0px;padding-right:0.0px;padding-top:0.0px;padding-bottom:0.0px;}
.farm-toolbar-row{flex-direction:row;justify-content:flex-end;}
.farm-toolbar-row-upper{margin-bottom:2.0px;}
.farm-toolbar-slot{position:relative;width:58.0px;height:58.0px;flex-shrink:0.0;margin-left:2.0px;margin-right:0.0px;padding-left:0.0px;padding-right:0.0px;padding-top:0.0px;padding-bottom:0.0px;}
.farm-toolbar-glow{position:absolute;left:0.0px;right:0.0px;top:0.0px;bottom:0.0px;background-color:rgba(0,0,0,0.0);border-top-left-radius:7.0px;border-top-right-radius:7.0px;border-bottom-left-radius:7.0px;border-bottom-right-radius:7.0px;}
.farm-toolbar-highlight{position:absolute;left:1.0px;right:1.0px;top:1.0px;bottom:1.0px;background-color:rgba(0,0,0,0.0);border-top-left-radius:5.0px;border-top-right-radius:5.0px;border-bottom-left-radius:5.0px;border-bottom-right-radius:5.0px;}
.farm-toolbar-slot-active .farm-toolbar-glow{background-color:rgba(180,103,24,0.20000000298023224);}
.farm-toolbar-slot-active .farm-toolbar-highlight{background-color:rgba(188,116,32,0.6200000047683716);}
.farm-toolbar-button{position:absolute;left:2.0px;right:2.0px;top:2.0px;bottom:2.0px;width:54.0px;height:54.0px;min-width:54.0px;min-height:54.0px;margin-left:0.0px;margin-right:0.0px;margin-top:0.0px;margin-bottom:0.0px;padding-left:6.0px;padding-right:6.0px;padding-top:6.0px;padding-bottom:6.0px;border-left-width:0.0px;border-right-width:0.0px;border-top-width:0.0px;border-bottom-width:0.0px;background-image:url("SquareFrame_sharedassets0.assets_77.png");-unity-background-scale-mode:stretch-to-fill;-unity-slice-left:28;-unity-slice-right:28;-unity-slice-top:28;-unity-slice-bottom:28;-unity-slice-scale:0.5px;background-color:rgba(0,0,0,0.0);-unity-background-image-tint-color:rgba(255,255,255,1.0);color:rgba(242,224,184,1.0);flex-direction:row;justify-content:center;align-items:center;}
.farm-toolbar-button:hover{-unity-background-image-tint-color:rgba(255,235,220,1.0);}
.farm-toolbar-button:disabled{opacity:1.0;-unity-background-image-tint-color:rgba(105,95,85,1.0);color:rgba(158,146,126,1.0);}
.farm-toolbar-icon{width:42.0px;height:42.0px;-unity-background-scale-mode:scale-to-fit;-unity-background-image-tint-color:rgba(255,248,235,1.0);}
.farm-toolbar-rank{display:none;position:absolute;left:0.0px;right:0.0px;top:0.0px;bottom:0.0px;translate:0.0 -2.0px;color:rgba(255,226,166,1.0);font-size:34.0px;-unity-font-style:bold;-unity-text-align:middle-center;-unity-text-outline-color:rgba(35,14,8,1.0);-unity-text-outline-width:2.0px;}
.farm-toolbar-label{display:none;color:rgba(242,224,184,1.0);font-size:11.0px;-unity-text-align:middle-center;}
.farm-toolbar-badge{display:none;position:absolute;right:-1.0px;top:-2.0px;width:20.0px;height:20.0px;padding-left:0.0px;padding-right:0.0px;padding-top:0.0px;padding-bottom:1.0px;background-color:rgba(118,18,14,0.9599999785423279);border-top-left-radius:10.0px;border-top-right-radius:10.0px;border-bottom-left-radius:10.0px;border-bottom-right-radius:10.0px;border-left-width:1.0px;border-right-width:1.0px;border-top-width:1.0px;border-bottom-width:1.0px;border-left-color:rgba(174,73,48,1.0);border-right-color:rgba(174,73,48,1.0);border-top-color:rgba(174,73,48,1.0);border-bottom-color:rgba(174,73,48,1.0);color:rgba(231,210,169,1.0);font-size:12.0px;-unity-font-style:bold;-unity-text-align:middle-center;}
.farm-toolbar-cooldown{position:absolute;left:4.0px;right:4.0px;top:4.0px;bottom:4.0px;color:rgba(0,0,0,0.7799999713897705);border-left-color:rgba(255,196,104,0.949999988079071);}
.farm-toolbar-cooldown-label{display:none;position:absolute;left:0.0px;right:0.0px;top:0.0px;bottom:0.0px;translate:0.0 -1.0px;color:rgba(255,241,214,1.0);font-size:16.0px;-unity-font-style:bold;-unity-text-align:middle-center;text-shadow:1.0px 1.0px 1.0px rgba(0,0,0,1.0);}
.farm-toolbar-cooling .farm-toolbar-cooldown-label{display:flex;}