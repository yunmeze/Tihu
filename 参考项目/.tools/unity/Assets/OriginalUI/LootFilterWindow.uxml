<ui:UXML xmlns:ui="UnityEngine.UIElements"><Style src="LootFilterWindow.uss"/><Style src="ManagementWindow.uss"/><ui:Template name="CheckboxRow" src="CheckboxRow.uxml"/><ui:Template name="ProjectDropdownRow" src="ProjectDropdownRow.uxml"/><ui:VisualElement name="loot-filter-window" class="management-window loot-filter-window"><ui:VisualElement name="LootFilterHeader" class="management-window-header"><ui:Label name="TitleLabel" text="Loot Filter" class="management-window-title"></ui:Label><ui:Button name="CloseButton" text="X" class="management-window-close"></ui:Button></ui:VisualElement><ui:VisualElement name="BodyRoot" class="management-window-body loot-filter-body"><ui:ScrollView name="FilterScroll" horizontal-scroller-visibility="Hidden" vertical-scroller-visibility="Auto" class="loot-filter-scroll management-window-scroll"><ui:VisualElement name="FilterScrollContent" class="loot-filter-scroll-content"><ui:Instance template="CheckboxRow"><ui:AttributeOverrides element-name="CheckboxToggle" label="Sell Common"/></ui:Instance><ui:Label name="SellCommonUnlockLabel" text="Unlock: Ash Sorter" class="management-window-row-muted loot-filter-unlock-label"></ui:Label><ui:Instance template="CheckboxRow"><ui:AttributeOverrides element-name="CheckboxToggle" label="Keep Rare+"/><ui:AttributeOverrides element-name="CheckboxToggle" value="true"/></ui:Instance><ui:Instance template="CheckboxRow"><ui:AttributeOverrides element-name="CheckboxToggle" label="Keep Stat"/></ui:Instance><ui:Label name="KeepStatUnlockLabel" text="Unlock: Black Wax Marker" class="management-window-row-muted loot-filter-unlock-label"></ui:Label><ui:Instance name="SelectedStatDropdown" template="ProjectDropdownRow" class="loot-filter-stat-row"><ui:AttributeOverrides element-name="ProjectDropdownRowLabel" text="Stat"/></ui:Instance><ui:Instance template="CheckboxRow"><ui:AttributeOverrides element-name="CheckboxToggle" label="Keep Legendaries"/><ui:AttributeOverrides element-name="CheckboxToggle" value="true"/></ui:Instance><ui:Label name="KeepLegendariesUnlockLabel" text="Unlock: Relic Hook" class="management-window-row-muted loot-filter-unlock-label"></ui:Label></ui:VisualElement></ui:ScrollView><ui:Label name="SummaryLabel" text="Common: keep | Rare+: keep&#10;Stat: off | Inbox review" class="management-window-summary loot-filter-summary"></ui:Label></ui:VisualElement></ui:VisualElement></ui:UXML>