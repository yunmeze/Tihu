.template-gallery{width:640.0px;min-height:480.0px;padding-left:18.0px;padding-right:18.0px;padding-top:12.0px;padding-bottom:12.0px;background-color:rgba(24,20,18,1.0);}
.template-gallery-title{margin-bottom:8.0px;}
.template-gallery-section{margin-bottom:10.0px;}
.template-gallery-heading{font-size:28.0px;margin-bottom:4.0px;}
.template-gallery-dropdown{width:300.0px;}
.template-gallery-dropdown .management-window-dropdown{margin-bottom:0.0px;}
.template-gallery-adaptive-button-reference{margin-bottom:6.0px;}
.template-gallery-reference-heading{margin-bottom:3.0px;font-size:18.0px;}
.template-gallery-adaptive-button-row{align-items:center;}
.template-gallery-adaptive-button{height:48.0px;margin-bottom:0.0px;font-size:26.0px;}
.template-gallery-adaptive-button-wide{width:190.0px;}
.template-gallery-adaptive-button-compact{width:120.0px;}
.template-gallery-skill-link{position:relative;width:180.0px;height:5.0px;margin-bottom:8.0px;}
.template-gallery-loot-review-item-slot{width:72.0px;height:108.0px;flex-grow:0.0;flex-shrink:0.0;}
.template-gallery-row{flex-direction:row;align-items:flex-start;}
.template-gallery-row *{margin-right:8.0px;}