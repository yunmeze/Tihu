<ui:UXML xmlns:ui="UnityEngine.UIElements"><Style src="ManagementWindow.uss"/><Style src="ZoneWindow.uss"/><ui:VisualElement name="zone-window" class="management-window zone-window"><ui:VisualElement name="ZoneHeader" class="management-window-header"><ui:Label name="TitleLabel" text="Farm Zone" class="management-window-title"></ui:Label><ui:Button name="CloseButton" text="X" class="management-window-close"></ui:Button></ui:VisualElement><ui:VisualElement name="BodyRoot" class="management-window-body zone-body"><ui:Label name="HintLabel" text="Choose where the hero farms." class="management-window-hint-text zone-hint"></ui:Label><ui:ScrollView name="ZoneList" horizontal-scroller-visibility="Hidden" vertical-scroller-visibility="Auto" class="zone-list management-window-scroll"></ui:ScrollView></ui:VisualElement></ui:VisualElement></ui:UXML>